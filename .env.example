# ==========================================
# AETHERIS — Environment Configuration
# ==========================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# ------------------------------------------
# Database (PostgreSQL)
# ------------------------------------------
DATABASE_URL="postgresql://postgres:your_password_here@localhost:5432/aether?schema=public"

# ------------------------------------------
# JWT Authentication
# ------------------------------------------
JWT_SECRET="CHANGE_ME_to_a_64_char_random_string"
JWT_REFRESH_SECRET="CHANGE_ME_to_another_64_char_random_string"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ------------------------------------------
# Server
# ------------------------------------------
PORT=5000
NODE_ENV="development"
FRONTEND_URL="http://localhost:3000"

# ------------------------------------------
# Redis (Optional — for Socket.io adapter)
# ------------------------------------------
REDIS_URL="redis://localhost:6379"

# ------------------------------------------
# Cloudinary (Optional — for file uploads)
# ------------------------------------------
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ------------------------------------------
# AI API Key (Optional)
# ------------------------------------------
GEMINI_API_KEY=""