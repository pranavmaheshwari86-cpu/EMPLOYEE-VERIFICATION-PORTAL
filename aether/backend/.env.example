PORT=5000
NODE_ENV=production
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/aether?retryWrites=true&w=majority
JWT_SECRET=generate_a_secure_random_string_for_jwt

# Frontend URL for CORS
FRONTEND_URL=https://aether-platform.vercel.app

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_ENTERPRISE=price_...

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# AI (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key

# Redis (Upstash)
REDIS_URL=rediss://default:<password>@<region>.upstash.io:<port>

# Email (Nodemailer)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM=noreply@aether-platform.com
